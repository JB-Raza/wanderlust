<div class="row all-listings row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4">
    <% for(let listing of allListings){ %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 18rem; object-fit: cover;">
                    <div class="card-body p-0 mt-2">
                        <h6 class="card-title fw-bold mb-1"><%= listing.title %></h6>
                        <p class="card-text text-muted mb-0"><%= listing.location %>, <%= listing.country %></p>
                        <p class="card-text fw-semibold mt-1">
                            Rs. <%= listing.price ? listing.price.toLocaleString("en-PK") : "N/A" %> <span class="fw-normal">/ night</span>
                            <i class="tax-rate text-secondary"> &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>
