<%- layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Create a New Listing</h3>
        <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input type="text" id="title" class="form-control" name="listing[title]" placeholder="Add a catchy title" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a valid title</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="image">Upload Image</label>
                <input class="form-control" type="file" id="image" name="listing[image]" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please select an image file</div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label class="form-label" for="price">Price</label>
                    <input class="form-control" type="number" id="price" name="listing[price]" placeholder="1200" min="0" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a valid price</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label class="form-label" for="country">Country</label>
                    <input class="form-control" type="text" id="country" name="listing[country]" placeholder="Pakistan" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a valid country name</div>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" id="location" name="listing[location]" placeholder="Hunza, Gilgit" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a valid location</div>
                </div>

                <div class="mb-3 col-md-6">
                    <label class="form-label" for="category">Category</label>
                    <select class="form-select" name="listing[category]" id="category" required>
                        <option value="">Choose a category</option>
                        <option value="Adventure">Adventure</option>
                        <option value="Valley">Valley</option>
                        <option value="Farm">Farm</option>
                        <option value="Mansion">Mansion</option>
                        <option value="Pool">Pool</option>
                        <option value="Camping">Camping</option>
                        <option value="Hiking">Hiking</option>
                        <option value="Arctic">Arctic</option>
                    </select>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please select a valid category</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Description</label>
                <textarea id="description" class="form-control" name="listing[description]" rows="4" placeholder="Enter a detailed description"></textarea>
            </div>

            <button class="btn theme-btn text-white px-4">Create Listing</button>
        </form>
    </div>
</div>
