<%- layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Edit Listing</h3>
        <form action="/listings/<%= listing._id %>?_method=PUT" method="post" class="needs-validation" novalidate enctype="multipart/form-data">

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid title</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Original Image</label>
                <div>
                    <img class="listing-preview-img rounded" src="<%= originalImgUrl %>" alt="Listing preview">
                </div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input type="file" id="image" name="listing[image]" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" class="form-control" min="0" required>
                    <div class="invalid-feedback">Please enter a valid price</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid country</div>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid location</div>
                </div>

                <div class="mb-3 col-md-6">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select" name="listing[category]" id="category">
                        <option value="Adventure" <%= listing.category === "Adventure" ? "selected" : "" %>>Adventure</option>
                        <option value="Valley" <%= listing.category === "Valley" ? "selected" : "" %>>Valley</option>
                        <option value="Farm" <%= listing.category === "Farm" ? "selected" : "" %>>Farm</option>
                        <option value="Mansion" <%= listing.category === "Mansion" ? "selected" : "" %>>Mansion</option>
                        <option value="Pool" <%= listing.category === "Pool" ? "selected" : "" %>>Pool</option>
                        <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
                        <option value="Hiking" <%= listing.category === "Hiking" ? "selected" : "" %>>Hiking</option>
                        <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="listing[description]" class="form-control" rows="5"><%= listing.description %></textarea>
            </div>

            <button class="btn theme-btn text-white">Update</button>
        </form>
    </div>
</div>
