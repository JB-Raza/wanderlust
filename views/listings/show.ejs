<%- layout('/layouts/boilerplate') %>

<div class="row mt-3">
    <div class="col-8 offset-2 show-listing-col">
        <h3 class="fw-bold"><%= listing.title %></h3>
        <div class="card listing-card mb-3">
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="card-img-top show-img rounded">
            <div class="card-body px-0">
                <p class="card-text mb-1 fw-bold fs-5">Owned By: <%= listing.owner ? listing.owner.username : "Anonymous" %></p>
                <% if(listing.category) { %>
                    <span class="badge bg-secondary mb-2"><%= listing.category %></span>
                <% } %>
                <p class="card-text"><%= listing.description %></p>
                <p class="card-text fw-semibold">Rs. <%= listing.price ? listing.price.toLocaleString("en-PK") : "Price Unavailable" %> / night</p>
                <p class="card-text text-muted"><%= listing.location %>, <%= listing.country %></p>

                <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)){ %>
                    <div class="d-flex gap-2 mt-3">
                        <a href="/listings/<%= listing._id %>/edit" class="btn theme-btn text-white">Edit</a>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="d-inline">
                            <button type="submit" class="btn btn-dark">Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <hr>

        <% if(currUser){ %>
            <div class="my-3">
                <h4 class="fw-bold">Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/review" method="post" class="my-3 needs-validation" novalidate>
                    <div class="my-2">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="my-2">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" class="form-control" rows="4" required></textarea>
                        <div class="invalid-feedback">Please enter comments for review</div>
                    </div>
                    <button type="submit" class="btn btn-outline-dark fw-bold">Submit</button>
                </form>
            </div>
            <hr>
        <% } %>

        <h4 class="fw-bold mb-3">All Reviews</h4>
        <% if(!listing.reviews.length){ %>
            <%- include("../includes/NoData.ejs") %>
        <% } else { %>
            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 p-3 shadow-sm border">
                            <div class="card-body p-0">
                                <h6 class="card-title fw-bold">@<%= review.author ? review.author.username : "User" %></h6>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                <p class="card-text"><%= review.comment %></p>
                            </div>
                            <% if(currUser && review.author && currUser._id.equals(review.author._id)){ %>
                                <form action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE" method="post" class="mt-2">
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
